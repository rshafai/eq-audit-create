{
  "_version": "1.60.0",
  "sap.app": {
    "id": "gc.agr.aafc.mm.eqauditcreate",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.4",
      "toolsId": "03f92ec9-0462-4b06-8862-1bf6fe392d9d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zqmm_ui_eq_barcode_v4/srvd/sap/zqmm_ui_eq_barcode/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "display-custom-rap-app": {
          "semanticObject": "EquipAudit", 
          "action": "create",
          "signature": {
            "parameters": {
              "CompanyCode": {
                "defaultValue": {
                  "value": "%%UserDefault.CompanyCode%%",
                  "format": "plain"
                }
              }
            },
            "additionalParameters": "allowed"
          }
        }
      }
    }
    
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.32",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "gc.agr.aafc.mm.eqauditcreate.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZQMM_C_Equip_BarcodeTRList",
          "target": "ZQMM_C_Equip_BarcodeTRList"
        },
        {
          "pattern": "ZQMM_C_Equip_BarcodeTR({key}):?query:",
          "name": "ZQMM_C_Equip_BarcodeTRObjectPage",
          "target": "ZQMM_C_Equip_BarcodeTRObjectPage"
        }
      ],
      "targets": {
        "ZQMM_C_Equip_BarcodeTRList": {
          "type": "Component",
          "id": "ZQMM_C_Equip_BarcodeTRList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZQMM_C_Equip_BarcodeTR",
              "variantManagement": "Page",
              "navigation": {
                "ZQMM_C_Equip_BarcodeTR": {
                  "detail": {
                    "route": "ZQMM_C_Equip_BarcodeTRObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "CreateAudit": {
                      "press": ".extension.gc.agr.aafc.mm.eqauditcreate.ext.controller.ListReportExt.onQuickInspect",
                      "text": "Quick Inspect",
                      "requiresSelection": false,
                      "enabled": true
                    }
                  },
                  "columns": {
                    "CustomMarkerColumn": {
                      "header": "",
                      "horizontalAlignment": "Center",
                      "width": "2.5rem",
                      "template": "gc.agr.aafc.mm.eqauditcreate.ext.fragment.AuditLockIndicator",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::Equipment"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ZQMM_C_Equip_BarcodeTRObjectPage": {
          "type": "Component",
          "id": "ZQMM_C_Equip_BarcodeTRObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZQMM_C_Equip_BarcodeTR"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "gc.agr.aafc.mm.eqauditcreate.ext.controller.ListReportExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
